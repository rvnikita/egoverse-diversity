# Copy to .env and fill in. .env is gitignored.

# Printed by: .venv/bin/modal deploy src/modal_vision.py
VISION_URL=

# elevenlabs.io > profile > API key. Ask the ElevenLabs table for hackathon credits.
ELEVENLABS_API_KEY=

# --- optional, only if you end up on one of these arms ---

# LeRobot SO-100 / SO-101: find with `python -m lerobot.find_port`
SO101_PORT=

# Viam machine (if you reuse the setup from the Viam hackathon)
VIAM_ADDRESS=
VIAM_API_KEY=
VIAM_API_KEY_ID=
VIAM_SERVICE_NAME=rv_code
